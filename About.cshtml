@{
    ViewBag.Title = "About";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #eef7f5;
            color: #173b35;
        }

        .header {
            background: #0f766e;
            color: white;
            text-align: center;
            padding: 45px 20px;
        }

            .header h1 {
                margin: 0 0 10px;
                font-size: 36px;
            }

            .header p {
                margin: 0;
                color: #d5f5f0;
            }

        .container {
            max-width: 900px;
            margin: 45px auto;
            padding: 0 20px;
        }

        .about-box {
            background: white;
            padding: 40px;
            border-radius: 16px;
            border: 1px solid #d7ebe7;
        }

            .about-box h2 {
                margin-top: 0;
                color: #0f766e;
            }

            .about-box p {
                color: #60736f;
                line-height: 1.8;
            }

        .details {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-top: 30px;
        }

        .detail {
            background: #f0fdfa;
            padding: 22px;
            border-radius: 12px;
            text-align: center;
        }

        .detail-icon {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .detail h3 {
            margin: 0 0 8px;
        }

        .detail p {
            margin: 0;
            font-size: 14px;
        }

        .footer {
            margin-top: 50px;
            background: #123c36;
            color: #d5f5f0;
            text-align: center;
            padding: 22px;
        }

        @@media (max-width: 650px) {
            .details {
                grid-template-columns: 1fr;
            }

            .about-box {
                padding: 25px;
            }
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>About Us</h1>
        <p>Learn more about our product catalog</p>
    </div>

    <div class="container">

        <div class="about-box">

            <h2>Our Product Catalog</h2>

            <p>
                Our Product Catalog is a simple web application developed
                using ASP.NET MVC architecture. The application provides
                an organized way to display different products along with
                their categories and prices.
            </p>

            <p>
                The project demonstrates the fundamental concepts of
                Model, View, Controller and Routing. It provides a clean
                interface that makes product information easy to understand
                and browse.
            </p>

            <div class="details">

                <div class="detail">
                    <div class="detail-icon">⚙️</div>
                    <h3>MVC</h3>
                    <p>Structured application architecture</p>
                </div>

                <div class="detail">
                    <div class="detail-icon">📋</div>
                    <h3>Catalog</h3>
                    <p>Organized product information</p>
                </div>

                <div class="detail">
                    <div class="detail-icon">🔗</div>
                    <h3>Routing</h3>
                    <p>Easy navigation between pages</p>
                </div>

            </div>

        </div>

    </div>

    <div class="footer">
        Product Catalog | ASP.NET MVC Application
    </div>

</body>
</html>